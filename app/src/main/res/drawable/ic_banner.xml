<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- 背景色 -->
    <path
        android:fillColor="@color/logobg"
        android:pathData="M0,0h320v180H0z" />

    <!-- 置中放置 Logo -->
    <group
        android:translateX="112"
        android:translateY="40"
        android:scaleX="0.375"
        android:scaleY="0.375">

        <!-- 1. 立方體頂面 -->
        <path android:pathData="M118,48 Q128,43 138,48 L206,83 Q214,88 206,93 L138,128 Q128,133 118,128 L50,93 Q42,88 50,83 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="44"
                    android:startY="84"
                    android:endX="212"
                    android:endY="92"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF36D1DC" />
                    <item android:offset="1.0" android:color="#FF5B86E5" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2. 右前側切面 -->
        <path android:pathData="M128,133 L206,93 Q214,88 214,98 L214,170 Q214,180 206,184 L128,222 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="128"
                    android:startY="128"
                    android:endX="220"
                    android:endY="224"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFDCE35B" />
                    <item android:offset="1.0" android:color="#FF96E6A1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 3. 左前側切面 -->
        <path android:pathData="M128,133 L50,93 Q42,88 42,98 L42,170 Q42,180 50,184 L128,222 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="128"
                    android:startY="128"
                    android:endX="36"
                    android:endY="224"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFFA709A" />
                    <item android:offset="1.0" android:color="#FFFEE140" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 4. 高光交界線 -->
        <path
            android:pathData="M128,133 L128,222"
            android:strokeColor="#40FFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />

        <!-- 5. 文字 R (透視修正版) -->
        <path
            android:pathData="M82,132 L82,184"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M82,132 L98,140 C106,144 106,156 98,160 L82,152"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M88,155 L102,181"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
    </group>

</vector>

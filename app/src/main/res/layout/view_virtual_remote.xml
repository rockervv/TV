<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="16dp">

    <!-- D-pad Panel (Initially Hidden) -->
    <RelativeLayout
        android:id="@+id/remote_panel"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_virtual_remote"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false">

        <ImageView
            android:id="@+id/btn_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_action_arrow"
            android:rotation="-90"
            android:focusable="false"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_action_arrow"
            android:rotation="90"
            android:focusable="false"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_action_arrow"
            android:rotation="180"
            android:focusable="false"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_action_arrow"
            android:focusable="false"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_ok"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerInParent="true"
            android:padding="12dp"
            android:src="@drawable/ic_keyboard"
            android:background="@drawable/bg_virtual_remote"
            android:backgroundTint="@color/white_20"
            android:focusable="false" />

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard_back"
            android:focusable="false"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </RelativeLayout>

    <!-- Toggle Button (Floating Icon) -->
    <ImageView
        android:id="@+id/remote_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:padding="10dp"
        android:src="@drawable/ic_keyboard_remote"
        android:background="@drawable/bg_virtual_remote"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="false" />

</FrameLayout>